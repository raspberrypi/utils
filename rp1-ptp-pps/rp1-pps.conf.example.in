# Copy to /etc/default/rp1-pps, edit the BCM GPIO values, then enable one unit.
PPS_INTERFACE=eth0
TESTPTP=@CMAKE_INSTALL_FULL_BINDIR@/testptp
PPS_MODE=input
PPS_GPIO=18
PPS_INPUT_GPIO=18
PPS_INPUT_GPIO2=24
PPS_OUTPUT_GPIO=23
PPS_INPUT_CHANNEL=0
PPS_EDGE=rising
PPS_EVENTS=0
PPS_EVENT_TIMEOUT=5
PPS_PERIOD_NS=1000000000
PPS_HIGH_NS=10000000
PPS_PHASE_NS=0
