define st_disp spi
    [copi 10] 
    [cipo 9] 
    [sclk 11] 
    [cs 8]
    [dc 25]
    [freq 25000000]

# sets externs so that you can have a seperate image file that is linked without changing the config
const width extern
const height extern
const tft_column_offset extern
const tft_line_offset extern

st_disp 0x11

delay [ms] 120

st_disp 0x3A 0x05
st_disp 0xC5 0x1A
st_disp 0x36 0x00

st_disp 0xB2 0x05 0x05 0x00 0x33 0x33
st_disp 0xB7 0x05

st_disp 0xBB 0x3F
st_disp 0xC0 0x2C
st_disp 0xC2 0x01
st_disp 0xC3 0x0F
st_disp 0xC4 0x20
st_disp 0xC6 0x01

st_disp 0xD0 0xA4 0xA1

st_disp 0xE8 0x03
st_disp 0xE9 0x09 0x09 0x08

st_disp 0xE0 0xD0 0x05 0x09 0x09 0x08 0x14 0x28 0x33 0x3F 0x07 0x13 0x14 0x28 0x30
st_disp 0xE1 0xD0 0x05 0x09 0x09 0x08 0x03 0x24 0x32 0x32 0x3B 0x14 0x13 0x28 0x2F

st_disp 0x21

st_disp 0x2A 
    (tft_column_offset >> 8) 
    (tft_column_offset & 0xFF) 
    ((tft_column_offset + width - 1) >> 8) 
    ((tft_column_offset + width - 1) & 0xFF)

st_disp 0x2B 
    (tft_line_offset >> 8) 
    (tft_line_offset & 0xFF) 
    ((tft_line_offset + height - 1) >> 8) 
    ((tft_line_offset + height - 1) & 0xFF)

import "st7789-img.splash"

delay 1
st_disp 0x29
